# subrata.tech - Apache config for the static portfolio
# Safe-by-default rules. Anything exotic is commented out so it can't bite us
# on a shared host like Hostinger.

# ---- Canonical host (www -> non-www) ------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---- Force HTTPS ---------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---- Directory options ---------------------------------------------------
Options -Indexes -MultiViews -ExecCGI

# ---- Hide sensitive files ------------------------------------------------
<FilesMatch "^(\.|.*\.log|.*\.sql|.*\.md|README\.md|package\.json|package-lock\.json|\.env|\.env\..*|\.gitignore)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule "(^|/)\.git(/|$)" - [F,L]
    RewriteRule "(^|/)\.env(\..*)?$" - [F,L]
    RewriteRule "(^|/)\.ht" - [F,L]
</IfModule>

# ---- Block server-side script execution ----------------------------------
# Static site never runs any of these
<FilesMatch "\.(php|php[0-9]?|phtml|phps|pl|cgi|py|asp|aspx|jsp|sh|bash|ksh|csh|tsh|hta)$">
    Require all denied
</FilesMatch>

RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .asp .aspx .jsp .sh .bash .ksh .csh
RemoveType    .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .asp .aspx .jsp .sh .bash .ksh .csh

# Belt-and-braces: force text/plain on any of the above in case a handler slips through
<IfModule mod_mime.c>
    AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .phps
    AddType text/plain .pl .py .cgi
    AddType text/plain .asp .aspx .jsp
    AddType text/plain .sh .bash .ksh .csh
</IfModule>

# ---- MIME types for legitimate assets ------------------------------------
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType image/webp .webp
AddType application/json .json
AddType application/xml .xml
AddType application/pdf .pdf
AddType text/html .html .htm
AddType image/x-icon .ico

# ---- Security headers ----------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # CSP: allow the CDNs actually used by the page
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://code.jquery.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://unicons.iconscout.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://unicons.iconscout.com data:; img-src 'self' data: https:; connect-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"

    Header unset X-Powered-By
    Header unset Server
    Header unset Via
</IfModule>

# ---- Cache policy for static assets --------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ---- Backup / editor temp files ------------------------------------------
<FilesMatch "(~|\.swp|\.bak|\.orig|\.tmp|\.save|\.old|\.DS_Store|Thumbs\.db|desktop\.ini)$">
    Require all denied
</FilesMatch>

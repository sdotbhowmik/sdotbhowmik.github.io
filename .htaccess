# subrata.tech - Apache config for the static portfolio
# Targets shared-hosting Apache (Hostinger) but works on most Apache 2.4 setups.

# ---- 1. Force HTTPS ------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---- 2. Canonical host ---------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---- 3. Disable directory listing ---------------------------------------
Options -Indexes -MultiViews

# ---- 4. Hide sensitive / unwanted files ---------------------------------
<FilesMatch "^(\.|.*\.log|.*\.sql|.*\.md|README\.md|package\.json|package-lock\.json|\.env|\.env\..*|\.gitignore)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule "(^|/)\.git(/|$)" - [F,L]
    RewriteRule "(^|/)\.env(\..*)?$" - [F,L]
</IfModule>

# ---- 5. Block execution of server-side scripts --------------------------
# (static site should never run any of these)
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phps|pl|cgi|py|asp|aspx|jsp|sh|bash|ksh|csh|tsh|hta|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Disable handlers for any non-HTML payload
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .asp .aspx .jsp .sh .bash .ksh .csh
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .asp .aspx .jsp .sh .bash .ksh .csh

# ---- 6. Set proper MIME types for assets --------------------------------
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType image/webp .webp
AddType application/json .json
AddType application/xml .xml
AddType application/pdf .pdf

# ---- 7. Security headers -------------------------------------------------
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "DENY"

    # Reflected XSS filter (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable powerful features we don't need
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

    # HSTS - 1 year, include subdomains, preload-ready
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Cross-origin isolation (modern)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Content-Security-Policy - tight but functional
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://code.jquery.com; style-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"

    # Remove identifying headers
    Header unset X-Powered-By
    Header unset Server
    Header unset Via
</IfModule>

# ---- 8. Cache policy for static assets ----------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ---- 9. Prevent access to backup / editor temp files --------------------
<FilesMatch "(~|\.swp|\.bak|\.orig|\.tmp|\.save|\.old|\.DS_Store|Thumbs\.db|desktop\.ini)$">
    Require all denied
</FilesMatch>

# ---- 10. Stop PHP / script execution in any upload folder ---------------
# Defensive: even though we don't have uploads anymore, if one gets created
<DirectoryMatch "(?i)uploads?|images">
    <FilesMatch "\.(php|php[0-9]?|phtml|phps|pl|py|cgi|asp|aspx|jsp|sh|bash)$">
        Require all denied
    </FilesMatch>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .asp .aspx .jsp .sh .bash
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .asp .aspx .jsp .sh .bash
    SetHandler default
    php_flag engine off
</DirectoryMatch>
